{
	"name": "mailsense",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node scripts/ensure-reacher-cli.mjs && vite dev",
		"build": "node scripts/ensure-reacher-cli.mjs && vite build",
		"start": "node scripts/start.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"reacher:install": "node scripts/ensure-reacher-cli.mjs",
		"validate:build": "node scripts/validate-railway-local.mjs build",
		"validate:runtime": "node scripts/validate-railway-local.mjs runtime",
		"validate:predeploy": "node scripts/validate-railway-local.mjs predeploy",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24",
		"@types/papaparse": "^5.5.2",
		"drizzle-kit": "^0.31.8",
		"eslint": "^10.0.3",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@fontsource-variable/dm-sans": "^5.2.8",
		"@fontsource-variable/fraunces": "^5.2.9",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@hono/zod-validator": "^0.7.6",
		"better-auth": "~1.4.21",
		"better-sqlite3": "^12.6.2",
		"date-fns": "^4.1.0",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.12.9",
		"papaparse": "^5.5.3",
		"xlsx": "^0.18.5",
		"zod": "^4.3.6"
	}
}

# SQLite
DATABASE_URL=./data/mailsense.db

# These must match the app URL exactly.
# Better Auth derives the Google callback from BETTER_AUTH_URL:
# <BETTER_AUTH_URL>/api/auth/callback/google
# Local default callback: http://localhost:5173/api/auth/callback/google
# Production should use your Railway URL or custom domain over https.
ORIGIN="http://localhost:5173"
BETTER_AUTH_URL="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Google OAuth
# https://www.better-auth.com/docs/authentication/google
# Create a Google OAuth "Web application" client.
# Authorized JavaScript origins should include:
# - http://localhost:5173
# - https://<your-railway-domain>
# Authorized redirect URIs should include:
# - http://localhost:5173/api/auth/callback/google
# - https://<your-railway-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Embedded verification
# MailSense downloads a pinned Reacher CLI binary into ./.reacher during dev/build.
# No hosted Reacher API or separate Reacher backend is required.
# Optional tuning:
REACHER_FROM_EMAIL=""
REACHER_HELLO_NAME=""
REACHER_SMTP_PORT="25"
REACHER_CHECK_GRAVATAR="false"
# Advanced override if you want to manage the binary location yourself.
# REACHER_CLI_PATH=".reacher/bin/check_if_email_exists"

# Verification tuning
VERIFICATION_PACING_MS="1500"
VERIFICATION_TIMEOUT_MS="15000"
VERIFICATION_BATCH_SIZE="25"
VERIFICATION_STALE_RUN_MINUTES="15"
MAX_UPLOAD_BYTES="10485760"
